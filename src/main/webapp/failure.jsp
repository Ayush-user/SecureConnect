<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Registration Failed</title>

<link rel="stylesheet" href="failure.css">

</head>
<body>

<div class="container">

    <div class="card">

        <div class="failure-icon">
            ✕
        </div>

        <h1>Registration Failed!</h1>

        <h2>Oops! Something went wrong.</h2>

        <p>
            We couldn't create your account.<br>
            Please verify your details and try registering again.
        </p>

        <div class="button-group">

            <a href="index.html" class="btn retry-btn">
                Register Again
            </a>

            <a href="login.html" class="btn login-btn">
                Go to Login
            </a>

        </div>

    </div>

</div>

</body>
</html>